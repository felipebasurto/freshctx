{
  "name": "freshctx",
  "version": "0.1.0",
  "description": "Local context engine for coding agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "freshctx": "bin/freshctx.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "vendor",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "node --check bin/freshctx.mjs src/*.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:check": "node test/package-contents.mjs"
  },
  "keywords": [
    "context",
    "tree-sitter",
    "agent",
    "jsonl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipebasurto/freshctx.git"
  },
  "homepage": "https://github.com/felipebasurto/freshctx#readme",
  "bugs": {
    "url": "https://github.com/felipebasurto/freshctx/issues"
  },
  "author": {
    "name": "Felipe Basurto",
    "url": "https://felipebasurto.com"
  },
  "private": true,
  "exports": {
    "./hash": "./src/hash.mjs",
    "./workspace": "./src/workspace.mjs"
  }
}
