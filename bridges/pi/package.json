{
  "name": "freshctx-pi",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi bridge for FreshCtx using the final Chat Completions request hook.",
  "license": "MIT",
  "author": {
    "name": "Felipe Basurto",
    "url": "https://felipebasurto.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/felipebasurto/freshctx.git",
    "directory": "bridges/pi"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "extension.js",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "freshctx"
  ],
  "pi": {
    "extensions": [
      "./extension.js"
    ]
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.41",
    "freshctx": "file:../.."
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0"
  },
  "scripts": {
    "check": "node --check extension.js && node --check src/bridge.mjs && node --check src/client.mjs",
    "test": "node --test test/*.test.mjs",
    "demo": "node demo.mjs"
  },
  "private": true
}
